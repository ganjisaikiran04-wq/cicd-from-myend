pipeline {
    agent any

    parameters {
        choice(
            name: 'action',
            choices: ['allow', 'deny'],
            description: 'Select the action which you want to perform'
        )
    }

    stages {
        stage('Git Clone') {
            steps {
                git branch: 'main', 
                url: 'https://github.com/ganjisaikiran04-wq/T-Form-Practice.git'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('Day-13-workspaces'){
                sh 'terraform init'
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression { params.action == 'allow' }
            }
            steps {
                dir('Day-13-workspaces'){
                sh 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Approval') {
            steps {
                input(
                    message: "You selected ${params.action}. Continue?",
                    ok: "Proceed"
                )
            }
        }

        stage('Execute') {
            steps {
                dir('Day-13-workspaces'){
                script {
                    if (params.action == 'allow') {
                        sh 'terraform apply -auto-approve tfplan'
                    } else {
                        sh 'terraform destroy -auto-approve'
                    }
                }
                }
            }
        }
    }
}

