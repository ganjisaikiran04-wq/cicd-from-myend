node {

    properties([
        parameters([
            choice(
                name: 'action',
                choices: ['allow', 'deny'],
                description: 'Choose the action which you want to perform'
            )
        ])
    ])

    stage('Approval Check') {
        echo "All parameters: ${params}"
        echo "Action value: '${params.action}'"

        if (params.action == 'deny') {
            error("Build stopped because approval was denied")
        } else {
            echo "Action is allow, continuing..."
        }
    }

    stage('Git-clone') {
        git branch: 'main',
            url: 'https://github.com/ganjisaikiran04-wq/T-Form-Practice.git'
    }

    stage('init') {
        dir('Day-13-workspaces') {
            sh 'terraform init'
        }
    }

    stage('Validate') {
        dir('Day-13-workspaces') {
            sh 'terraform validate'
        }
    }

    stage('Fmt Check') {
        dir('Day-13-workspaces') {
            sh 'terraform fmt -check'
        }
    }

    stage('Terraform Plan') {
        dir('Day-13-workspaces') {
            sh 'terraform plan -out=tfplan'
        }
    }

    stage('Approval') {
        input(
            message: "You selected ${params.action}. Continue?",
            ok: "Proceed"
        )
    }

    stage('Execute') {
        dir('Day-13-workspaces') {
            if (params.action == 'allow') {
                sh 'terraform apply -auto-approve tfplan'
            } else {
                sh 'terraform destroy -auto-approve'
            }
        }
    }
}

